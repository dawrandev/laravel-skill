# Install scripts run arbitrary code from every transitive dependency.
# Disable them, then run `npm rebuild <pkg>` for the few that genuinely need one.
ignore-scripts=true

# Refuse versions published in the last 7 days (value is in minutes). Most
# malicious releases are found and pulled within hours. npm supports this but
# leaves it off by default.
minimum-release-age=10080

audit-level=high

# Reproducible installs. Use `npm ci`, never `npm install`, in CI.
save-exact=false
